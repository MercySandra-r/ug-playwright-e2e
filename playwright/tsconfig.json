{
  // Type-checks the framework's JavaScript (checkJs, strict). Run: npx tsc --noEmit -p .
  // Editors use this file too, so there is no separate jsconfig.json.
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "**/*.js",
    "**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    // Generated output: bundled report viewer, run artifacts, debug files.
    "reports",
    "test-results",
    "artifacts"
  ]
}
