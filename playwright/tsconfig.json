{
  // Type-checks the framework's JavaScript (checkJs, strict). Run: npx tsc --noEmit -p .
  // Editors use this file too, so there is no separate jsconfig.json.
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    "**/*.js",
    "**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    // Generated output: bundled report viewer, run artifacts, debug files.
    "reports",
    "test-results",
    "artifacts",
    // Flow specs TC_17-TC_27 (F1-F11) still call page-object methods from before the
    // site changed and need rebuilding; they are left out until then. Newer flows
    // (TC_29_F12 onwards) are checked.
    "tests/TC_1?_F?_*",
    "tests/TC_2?_F?_*",
    "tests/TC_26_F10_*",
    "tests/TC_27_F11_*"
  ]
}
