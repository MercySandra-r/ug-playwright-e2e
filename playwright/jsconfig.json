{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*"]
    },
    "allowJs": true,
    "checkJs": true
  },
  "include": ["**/*.js", "**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}
