{
  "name": "undergrad-playwright",
  "version": "1.0.0",
  "description": "Playwright Test Framework for Undergraduate Application",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chrome": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke --workers=6 --retries=1",
    "test:regression": "playwright test --project=chromium --grep @regression --workers=8 --retries=1",
    "test:full": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:edge": "playwright test --project=msedge",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit --project=msedge",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:dup-identity": "playwright test tests/TC_20_F7_DuplicateApp_Submission_Check_PSwaiver.spec.js --project=chromium --headed --retries=0",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "lint": "eslint ."
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.8.6",
    "@types/pngjs": "^6.0.5",
    "allure-playwright": "^2.8.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.51.0",
    "eslint-plugin-playwright": "^0.18.0",
    "prettier": "^3.0.3",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@google-cloud/local-auth": "^3.0.1",
    "@slack/web-api": "^7.9.3",
    "axios": "^1.5.1",
    "csv-parse": "^5.5.2",
    "d3-dsv": "^3.0.1",
    "exceljs": "^4.3.0",
    "googleapis": "^153.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "winston": "^3.11.0"
  },
  "directories": {
    "test": "tests"
  }
}
