# Environment (local, qa, staging, prod)
NODE_ENV=qa

# Base URLs
BASE_URL=https://apply-qa.apps.asu.edu
API_BASE_URL=https://api-qa.apps.asu.edu

# Test configuration
TIMEOUT=30000
RETRIES=1
HEADLESS=true
SCREENSHOT=true
VIDEO=false
TRACING=false

# Authentication
DEFAULT_USERNAME=
DEFAULT_PASSWORD=

# Integration tokens
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
DROPBOX_TOKEN=your_dropbox_token
GOOGLE_DRIVE_TOKEN=your_google_drive_token

# Reporting
HTML_REPORT=true
JSON_REPORT=true
ALLURE_REPORT=false

# --- Email-verification test mailbox (Gmail API) ---
# Real Gmail inbox used to receive ASU sign-up verification mail. Unique per-run
# addresses are derived as base+<timestamp>@gmail.com (all land in this inbox).
GMAIL_TEST_ADDRESS=
# OAuth desktop-client credentials + cached token (scope: gmail.readonly).
# Keep BOTH out of git. gmail-token.json is created on first authorized run.
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/gmail-token.json
# Optional extra inboxes (_2 ... _5). When the IdP rate-limits one inbox ("Too many email
# verification requests"), sign-ups switch to the next and leave the limited one alone for
# an hour. Each inbox needs its own authorised token file.
# GMAIL_TEST_ADDRESS_2=another.qa.inbox@gmail.com
# GMAIL_CREDENTIALS_PATH_2=credentials/credentials-2.json
# GMAIL_TOKEN_PATH_2=credentials/gmail-token-2.json
# Sign-up address sequence: base+<prefix><NNNN>@gmail.com, persisted in state/email-sequence.json
GMAIL_SEQUENCE_PREFIX=asuqa
GMAIL_SEQUENCE_START=1

# Review (TC_12): the two submit tests are skipped unless this is 1. Submission cannot be
# undone: with 1, every TC_12 run really submits one application in QA.
REVIEW_ALLOW_SUBMIT=

# Optional: reuse a parked account per page suite instead of creating one on every run.
# Each needs an account sitting unsaved on that suite's step. With a pair set, the suite
# keeps that account for its other tests and runs its save test on an account from the
# account pool (state/account-pool.json, see utils/accountPool.js), so the parked account
# stays put and works on every run.
# PREAPP_TEST_EMAIL=          # TC_05: signed up, no application
# PREAPP_TEST_PASSWORD=
# MYINFO_TEST_EMAIL=          # TC_06: on step 1, My information
# MYINFO_TEST_PASSWORD=
# MYPROGRAM_TEST_EMAIL=       # TC_07: on step 2, My program
# MYPROGRAM_TEST_PASSWORD=
# MYSCHOOLS_TEST_EMAIL=       # TC_08: on step 3, My schools
# MYSCHOOLS_TEST_PASSWORD=
# GRADES_TEST_EMAIL=          # TC_09: on step 4, past graduate
# GRADES_TEST_PASSWORD=
# GRADES_FUTURE_TEST_EMAIL=   # TC_09: on step 4, future graduation date
# GRADES_FUTURE_TEST_PASSWORD=
# RESIDENCY_TEST_EMAIL=       # TC_10 first group: on step 5, default applicant
# RESIDENCY_TEST_PASSWORD=
# TC_10 scenario groups: RESIDENCY_SCENARIO_TEST_PASSWORD plus each scenario's envKey
# (see AZResidencyPage.RESIDENCY_SCENARIOS).

# Optional: an account with an already-submitted application, for post-submission suites (TC_13).
SUBMITTED_TEST_EMAIL=
SUBMITTED_TEST_PASSWORD=

# Test SSN for the duplicate-application flow (F7, TC_23) only: it must be the same number as the
# application already in QA. Set it yourself; leave blank otherwise. 9 digits, no dashes.
# Every other U.S. citizen applicant gets a made-up number from a never-issued range, new on
# each run (utils/syntheticSsn.js), so applicants don't look like duplicates of each other.
TEST_SSN=
